# ==========================================
# Syntrix Production Environment Blueprint
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://syntrix.app
CORS_ORIGIN=https://syntrix.app

# Database (MySQL / MariaDB Connection URI)
DATABASE_URL=mysql://syntrix_user:STRONG_SECURE_PASSWORD@db.syntrix.internal:3306/syntrix?connection_limit=20&pool_timeout=10

# Security & JSON Web Tokens
JWT_SECRET=GENERATE_64_CHAR_HEX_SECRET_STRING_FOR_PRODUCTION_AUTH
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# In-Memory Cache & Message Broker (Redis)
REDIS_HOST=redis.syntrix.internal
REDIS_PORT=6379
REDIS_PASSWORD=STRONG_REDIS_AUTH_PASSWORD
REDIS_ENABLED=true

# Storage & File Uploads
UPLOAD_DIR=/data/uploads
MAX_FILE_SIZE_MB=10
