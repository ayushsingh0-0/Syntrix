generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  USER
  ADMIN
  MANAGER
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  password            String
  role                UserRole             @default(USER)
  isEmailVerified     Boolean              @default(false)
  bio                 String?              @db.VarChar(500)
  avatarUrl           String?              @db.VarChar(1000)
  phone               String?              @db.VarChar(30)

  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  organizationMemberships OrganizationMember[]
  sentInvitations         Invitation[]
  teamMemberships         TeamMember[]
  projectMemberships      ProjectMember[]
  assignedTasks           Task[]                   @relation("TaskAssignee")
  reportedTasks           Task[]                   @relation("TaskReporter")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(500)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.VarChar(255)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.VarChar(255)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum AuthAuditEvent {
  LOGIN_SUCCESS
  LOGIN_FAILED
  REGISTER_SUCCESS
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFIED
  TOKEN_REUSE_DETECTED
  LOGOUT
  LOGOUT_ALL
}

model AuthAuditLog {
  id        String         @id @default(cuid())
  event     AuthAuditEvent
  userId    String?
  email     String?
  ipAddress String?
  userAgent String?        @db.VarChar(500)
  metadata  Json?
  createdAt DateTime       @default(now())
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  GUEST
}


model Organization {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique @db.VarChar(100)
  logoUrl     String?              @db.VarChar(1000)
  isArchived  Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  members     OrganizationMember[]
  invitations Invitation[]
  teams       Team[]
  projects    Project[]
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           OrganizationRole @default(MEMBER)
  invitedById    String
  tokenHash      String           @unique @db.VarChar(255)
  expiresAt      DateTime
  status         InvitationStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User             @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
}

enum TeamRole {
  LEAD
  MEMBER
}

model Team {
  id             String       @id @default(cuid())
  organizationId String
  name           String       @db.VarChar(100)
  description    String?      @db.VarChar(500)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        TeamMember[]
  projects       Project[]

  @@index([organizationId, name])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectRole {
  LEAD
  MEMBER
  VIEWER
}

model Project {
  id             String          @id @default(cuid())
  organizationId String
  teamId         String?
  name           String          @db.VarChar(100)
  key            String          @db.VarChar(10)
  description    String?         @db.VarChar(1000)
  status         ProjectStatus   @default(ACTIVE)
  priority       ProjectPriority @default(MEDIUM)
  startDate      DateTime?
  targetDate     DateTime?
  isArchived     Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team           Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  members        ProjectMember[]
  boards         Board[]
  tasks          Task[]

  @@unique([organizationId, key])
  @@index([organizationId, status])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Board {
  id          String        @id @default(cuid())
  projectId   String
  name        String        @db.VarChar(100)
  description String?       @db.VarChar(500)
  isDefault   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns     BoardColumn[]

  @@index([projectId])
}

model BoardColumn {
  id        String   @id @default(cuid())
  boardId   String
  name      String   @db.VarChar(50)
  position  Int
  color     String?  @db.VarChar(20)
  wipLimit  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([boardId, position])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

model Task {
  id             String       @id @default(cuid())
  projectId      String
  columnId       String?
  number         Int
  key            String       @db.VarChar(20)
  title          String       @db.VarChar(255)
  description    String?      @db.Text
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(TODO)
  position       Float        @default(65535.0)
  assigneeId     String?
  reporterId     String
  dueDate        DateTime?
  estimatedHours Float?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column         BoardColumn? @relation(fields: [columnId], references: [id], onDelete: SetNull)
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter       User         @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: Restrict)

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([columnId, position])
}







