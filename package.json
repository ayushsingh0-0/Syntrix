{
  "name": "syntrix",
  "private": true,
  "version": "1.0.0",
  "description": "Enterprise Team Collaboration Platform",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "build": "npm --workspace=backend run build && npm --workspace=frontend run build",
    "test": "npm --workspace=backend test && npm --workspace=frontend test",
    "test:backend": "npm --workspace=backend test",
    "test:frontend": "npm --workspace=frontend test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
